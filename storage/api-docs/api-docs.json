{
    "openapi": "3.0.0",
    "info": {
        "title": "EcoFund API",
        "description": "Dokumentasi API backend EcoFund.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api",
            "description": "Server API"
        }
    ],
    "paths": {
        "/auth/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Registrasi user baru",
                "operationId": "registerUser",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "nama",
                                    "email",
                                    "no_hp",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "nama": {
                                        "type": "string",
                                        "example": "Budi Santoso"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "budi@example.com"
                                    },
                                    "no_hp": {
                                        "type": "string",
                                        "example": "081234567890"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "secret123"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "secret123"
                                    },
                                    "foto": {
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Registrasi berhasil"
                    },
                    "422": {
                        "description": "Validasi gagal"
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Login dengan email atau nomor HP",
                "operationId": "loginUser",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "login",
                                    "password"
                                ],
                                "properties": {
                                    "login": {
                                        "type": "string",
                                        "example": "081234567890"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "secret123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login berhasil"
                    },
                    "422": {
                        "description": "Login gagal"
                    }
                }
            }
        },
        "/campaigns": {
            "post": {
                "tags": [
                    "Campaigns"
                ],
                "summary": "Buat campaign baru",
                "operationId": "createCampaign",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "kategori_id",
                                    "identities",
                                    "judul",
                                    "deskripsi",
                                    "target_donasi",
                                    "payment_method"
                                ],
                                "properties": {
                                    "kategori_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "identities": {
                                        "type": "string",
                                        "example": "other_people_or_community",
                                        "enum": [
                                            "for_yourself",
                                            "organization_or_company",
                                            "other_people_or_community"
                                        ]
                                    },
                                    "judul": {
                                        "type": "string",
                                        "example": "Bantu Renovasi Sekolah"
                                    },
                                    "deskripsi": {
                                        "type": "string",
                                        "example": "Penggalangan dana untuk renovasi sekolah desa."
                                    },
                                    "target_donasi": {
                                        "type": "integer",
                                        "example": 50000000
                                    },
                                    "lokasi": {
                                        "type": "string",
                                        "example": "Bandung"
                                    },
                                    "payment_method": {
                                        "type": "string",
                                        "example": "bank_transfer"
                                    },
                                    "gambar": {
                                        "type": "string",
                                        "format": "binary"
                                    },
                                    "supporting_document": {
                                        "type": "string",
                                        "format": "binary"
                                    },
                                    "tanggal_mulai": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-04-24"
                                    },
                                    "tanggal_selesai": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-05-30"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Campaign berhasil dibuat"
                    },
                    "401": {
                        "description": "Belum login"
                    },
                    "422": {
                        "description": "Validasi gagal"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "description": "Gunakan format: Bearer {token}",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "Campaigns",
            "description": "Campaigns"
        }
    ]
}